<Window x:Class="NapiQuiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Napi Quiz"
        Height="400"
        Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">

    <Grid>
        <Border Background="White"
                CornerRadius="15"
                Padding="25"
                Margin="20">
            <StackPanel>
                <TextBlock Text="Napi Quiz"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

				

				<Button Content="Felhasználói felület"
            Style="{StaticResource MainButtonStyle}"
            Click="UserButton_Click"/>

                    <Button Content="Admin felület"
            Style="{StaticResource MainButtonStyle}"
            Click="AdminButton_Click"/>

                    <Button Content="Toplista"
            Style="{StaticResource MainButtonStyle}"
            Click="LeaderboardButton_Click"/>

                    <Button Content="Kilépés"
            Style="{StaticResource DangerButtonStyle}"
            Click="LogoutButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>