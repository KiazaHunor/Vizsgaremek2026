<Window x:Class="NapiQuiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Napi Quiz"
        Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f5f7fb">

    <Grid>
        <Border Background="White"
                CornerRadius="15"
                Padding="25"
                Margin="20">

            <StackPanel>

                <TextBlock Text="⚽ Napi Foci Quiz"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <Button Content="👤 Felhasználói felület"
                        Click="UserButton_Click"/>

                <Button Content="🛠️ Admin felület"
                        Click="AdminButton_Click"/>

                <Button Content="🏆 Toplista"
                        Margin="0,5,0,20"
                        Click="LeaderboardButton_Click"/>

                <Button Content="🚪 Kijelentkezés"
                        Background="#ef4444"
                        Click="LogoutButton_Click"/>

            </StackPanel>

        </Border>
    </Grid>
</Window>