<Window x:Class="NapiQuiz.Views.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Napi Quiz" Height="520" Width="620"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
	<Window.Resources>
		<Style x:Key="AnswerButtonStyle" TargetType="Button">
			<Setter Property="Height" Value="45"/>
			<Setter Property="Margin" Value="0,6,0,0"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#3B82F6"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
		<Grid Margin="20">
			<Border Background="White" CornerRadius="16" Padding="24">
				<StackPanel>
					<TextBlock Text="Napi Quiz"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,20"/>

					<TextBlock Text="Felhasználónév"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

					<TextBox x:Name="UserNameTextBox"
                             Height="38"
                             Margin="0,8,0,18"
                             FontSize="14"
                             Padding="10"/>

					<Border Background="#EEF2FF" CornerRadius="12" Padding="16" Margin="0,0,0,18">
						<TextBlock x:Name="QuestionTextBlock"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   TextWrapping="Wrap"/>
					</Border>

					<Button x:Name="ButtonA" Style="{StaticResource AnswerButtonStyle}" Click="Answer_Click"/>
					<Button x:Name="ButtonB" Style="{StaticResource AnswerButtonStyle}" Click="Answer_Click"/>
					<Button x:Name="ButtonC" Style="{StaticResource AnswerButtonStyle}" Click="Answer_Click"/>
					<Button x:Name="ButtonD" Style="{StaticResource AnswerButtonStyle}" Click="Answer_Click"/>

					<Border x:Name="ResultBorder"
                            Background="#E5E7EB"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,18,0,0"
                            Visibility="Collapsed">
						<TextBlock x:Name="ResultTextBlock"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="#111827"/>
					</Border>
				</StackPanel>
			</Border>
		</Grid>
	</ScrollViewer>
</Window>