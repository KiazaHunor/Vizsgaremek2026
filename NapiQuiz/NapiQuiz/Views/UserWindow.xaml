<Window x:Class="NapiQuiz.Views.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Napi Quiz"
        Height="590"
        Width="620"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">

    <Grid Margin="20">
        <Border Background="White"
                CornerRadius="16"
                Padding="20">
            <Grid>
                <Button Content="Vissza"
                        Width="90"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="BackButton_Click"/>

                <StackPanel Margin="0,58,0,0">
                    <TextBlock Text="Napi Quiz"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Felhasználónév"
                               FontWeight="SemiBold"/>
                    <TextBox x:Name="UserNameTextBox"
                             Height="35"
                             Margin="0,5,0,15"
                             Padding="10"/>

                    <TextBlock x:Name="QuestionTextBlock"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>

                    <Button x:Name="ButtonA"
                    Style="{StaticResource MainButtonStyle}"
                    Click="Answer_Click"/>

                    <Button x:Name="ButtonB"
                    Style="{StaticResource MainButtonStyle}"
                    Click="Answer_Click"/>

                    <Button x:Name="ButtonC"
                    Style="{StaticResource MainButtonStyle}"
                    Click="Answer_Click"/>

                    <Button x:Name="ButtonD"
                    Style="{StaticResource MainButtonStyle}"
                    Click="Answer_Click"/>  

                    <Border x:Name="ResultBorder"
                            Background="#E5E7EB"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,15,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ResultTextBlock"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
                
            </Grid>
        </Border>
    </Grid>
</Window>