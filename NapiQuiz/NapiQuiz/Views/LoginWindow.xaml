<Window x:Class="NapiQuiz.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bejelentkezés"
        Height="400" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f5f7fb">

	<Grid>
		<Border Background="White"
                CornerRadius="15"
                Padding="25"
                Margin="20">

			<StackPanel>

				<TextBlock Text="Bejelentkezés"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

				<TextBlock Text="Felhasználónév"
                           Margin="0,0,0,5"
                           FontWeight="SemiBold"/>

				<TextBox x:Name="UsernameTextBox"
                         Height="35"
                         Margin="0,0,0,10"
                         Padding="10"/>

				<TextBlock Text="Jelszó"
                           Margin="0,0,0,5"
                           FontWeight="SemiBold"/>

				<PasswordBox x:Name="PasswordBox"
                             Height="35"
                             Margin="0,0,0,15"
                             Padding="10"/>

				<Button Content="Belépés"
                        Click="Login_Click"/>

			</StackPanel>

		</Border>
	</Grid>
</Window>