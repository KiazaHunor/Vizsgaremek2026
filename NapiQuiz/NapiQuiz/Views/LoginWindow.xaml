<Window x:Class="NapiQuiz.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bejelentkezés"
        Height="350"
        Width="380"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="16" Padding="20">
            <StackPanel>
                <TextBlock Text="Bejelentkezés"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Felhasználónév"/>
                <TextBox x:Name="UsernameTextBox"
                         Height="35"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Jelszó"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="35"
                             Margin="0,5,0,20"/>

                <Button Content="Belépés"
                        Height="35"
                        Click="Login_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>