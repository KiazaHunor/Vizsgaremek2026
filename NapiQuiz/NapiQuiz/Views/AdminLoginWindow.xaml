<Window x:Class="NapiQuiz.Views.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin belépés"
        Height="400" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f5f7fb">

	<Grid>
		<Border Background="White"
                CornerRadius="15"
                Padding="25"
                Margin="20">

			<Grid>
				<Button Content="Vissza"
                        Width="80"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#ef4444"
                        Click="BackButton_Click"/>

				<StackPanel Margin="0,45,0,0">
					<TextBlock Text="Admin belépés"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

					<TextBlock Text="Admin jelszó"
                               Margin="0,0,0,5"
                               FontWeight="SemiBold"/>

					<PasswordBox x:Name="AdminPasswordBox"
                                 Height="35"
                                 Margin="0,0,0,15"
                                 Padding="10"/>

					<Button Content="Belépés"
                            Click="Login_Click"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>