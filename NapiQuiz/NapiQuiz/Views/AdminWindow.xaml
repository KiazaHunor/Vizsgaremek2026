<Window x:Class="NapiQuiz.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin felület" Height="500" Width="500">
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Új kérdés felvitele" FontSize="22" Margin="0,0,0,20"/>

            <TextBlock Text="Kérdés"/>
            <TextBox x:Name="QuestionTextBox" Margin="0,5,0,10" Height="30"/>

            <TextBlock Text="A válasz"/>
            <TextBox x:Name="AnswerATextBox" Margin="0,5,0,10" Height="30"/>

            <TextBlock Text="B válasz"/>
            <TextBox x:Name="AnswerBTextBox" Margin="0,5,0,10" Height="30"/>

            <TextBlock Text="C válasz"/>
            <TextBox x:Name="AnswerCTextBox" Margin="0,5,0,10" Height="30"/>

            <TextBlock Text="D válasz"/>
            <TextBox x:Name="AnswerDTextBox" Margin="0,5,0,10" Height="30"/>

            <TextBlock Text="Helyes válasz"/>
            <TextBox x:Name="CorrectAnswerTextBox" Margin="0,5,0,15" Height="30"/>

            <Button Content="Kérdés mentése"
                    Height="35"
                    Margin="0,0,0,10"
                    Click="SaveQuestion_Click"/>

            <Button Content="Legutolsó kérdés legyen a mai"
                    Height="35"
                    Click="SetTodayQuestion_Click"/>
            <Button Content="← Vissza"
        Height="35"
        Margin="0,20,0,0"
        Background="#6B7280"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand"
        Click="BackButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>