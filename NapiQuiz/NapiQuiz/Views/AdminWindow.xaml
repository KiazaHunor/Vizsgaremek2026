<Window x:Class="NapiQuiz.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin felület"
        Height="620"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <Grid>
        <Border Background="White"
                CornerRadius="15"
                Padding="25"
                Margin="20">
            <Grid>
                <Button Content="Vissza"
                        Width="90"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="BackButton_Click"/>

                <ScrollViewer Margin="0,58,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Admin felület"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Új kérdés felvitele"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Kérdés"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="QuestionTextBox"
                                 Height="80"
                                 Margin="0,5,0,12"
                                 Padding="10"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"/>

                        <TextBlock Text="A válasz"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="AnswerATextBox"
                                 Height="35"
                                 Margin="0,5,0,12"
                                 Padding="10"/>

                        <TextBlock Text="B válasz"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="AnswerBTextBox"
                                 Height="35"
                                 Margin="0,5,0,12"
                                 Padding="10"/>

                        <TextBlock Text="C válasz"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="AnswerCTextBox"
                                 Height="35"
                                 Margin="0,5,0,12"
                                 Padding="10"/>

                        <TextBlock Text="D válasz"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="AnswerDTextBox"
                                 Height="35"
                                 Margin="0,5,0,12"
                                 Padding="10"/>

                        <TextBlock Text="Helyes válasz"
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="CorrectAnswerComboBox"
                                  Margin="0,5,0,15"
                                  Height="35">
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="B"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="D"/>
                        </ComboBox>

                        <Button Content="Kérdés mentése"
                        Style="{StaticResource MainButtonStyle}"
                        Click="SaveQuestion_Click"/>

                         <Button Content="Legutolsó kérdés legyen a mai"
                        Style="{StaticResource MainButtonStyle}"
                        Click="SetTodayQuestion_Click"/>

                        
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>